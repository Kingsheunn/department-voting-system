NODE_ENV=development
PORT=3000
STORE_DRIVER=memory
DOJAH_APP_ID=your_sandbox_app_id
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_PRIVATE_KEY=your_sandbox_private_key
DOJAH_WEBHOOK_SECRET=your_sandbox_webhook_secret
DOJAH_WIDGET_ID=your_public_widget_id
DOJAH_VERIFICATION_CONTRACT_CONFIRMED=false
DOJAH_ALLOWED_DOCUMENT_TYPES=your_exact_document_type
DOJAH_IMAGE_HOSTS=images.dojah.io,your_exact_account_host.r2.cloudflarestorage.com
ACCOUNT_PROVISIONING_ENABLED=false
MANUAL_REVIEW_ENABLED=false
ELECTION_CONFIGURATION_ENABLED=false
RETENTION_CLEANUP_ENABLED=false
RETENTION_CLEANUP_SECRET=generate_a_different_32_character_secret
FIREBASE_PROJECT_ID=your_firebase_project_id
# Set only for an explicitly approved hosted DoJah sandbox pilot. It must
# exactly match FIREBASE_PROJECT_ID and must be removed before switching live.
HOSTED_SANDBOX_FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
PRODUCTION_INGRESS_RATE_LIMIT_CONFIRMED=false
EDGE_SHARED_SECRET=generate_at_least_32_random_characters
WEB_ALLOWED_ORIGINS=https://your-voter-site.web.app,https://your-reviewer-site.web.app
GOOGLE_APPLICATION_CREDENTIALS=your_firebase_service_account_path
# Hosted cleanup uses one secret JSON value instead of a local file path.
FIREBASE_SERVICE_ACCOUNT_JSON=
