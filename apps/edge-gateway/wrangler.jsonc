{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "department-voting-edge",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ALLOWED_PORTAL_ORIGINS": "https://voting-app-6e1fb.web.app,https://voting-app-6e1fb-reviewer.web.app"
  },
  "secrets": {
    "required": ["UPSTREAM_ORIGIN", "ORIGIN_SHARED_SECRET", "RETENTION_CLEANUP_SECRET"]
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "ratelimits": [
    {
      "name": "ATTEMPT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
