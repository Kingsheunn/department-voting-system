# DoJah sandbox API
NODE_ENV=development
PORT=3000
STORE_DRIVER=firestore
DOJAH_APP_ID=your_sandbox_app_id
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_PRIVATE_KEY=your_sandbox_private_key
DOJAH_WEBHOOK_SECRET=your_sandbox_webhook_secret
DOJAH_WIDGET_ID=your_public_widget_id
DOJAH_VERIFICATION_CONTRACT_CONFIRMED=false
DOJAH_ALLOWED_DOCUMENT_TYPES=your_exact_document_type
DOJAH_IMAGE_HOSTS=images.dojah.io,your_exact_account_host.r2.cloudflarestorage.com
ACCOUNT_PROVISIONING_ENABLED=false
MANUAL_REVIEW_ENABLED=false
PRODUCTION_INGRESS_RATE_LIMIT_CONFIRMED=false
EDGE_SHARED_SECRET=generate_at_least_32_random_characters
WEB_ALLOWED_ORIGINS=https://your-voter-site.web.app,https://your-reviewer-site.web.app

# Firebase Local Emulator Suite
FIREBASE_PROJECT_ID=demo-department-voting
# Hosted sandbox deployments may set this to the exact non-demo Firebase
# project ID. Leave it empty for emulator development and remove it for live DoJah.
HOSTED_SANDBOX_FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Firebase web SDK values are public; demo values stay emulator-only.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-department-voting.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-department-voting
VITE_FIREBASE_APP_ID=demo-web-app
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_API_BASE_URL=https://your-edge-gateway.workers.dev
